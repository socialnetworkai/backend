def app
pipeline {
    agent any
    environment {
        ENV_TYPE = "production"
        PORT = 4136
        NAMESPACE = "socialnetwork-ai-com"
        REGISTRY_HOSTNAME = "socialnetworkai"
        PROJECT = "soc-net-main"
        SERVICE="main"
        REGISTRY = "registry.hub.docker.com"
        DEPLOYMENT_NAME = "soc-net-main-deployment"
        IMAGE_NAME = "${env.BUILD_ID}_${env.ENV_TYPE}_${env.GIT_COMMIT}"
        DOCKER_BUILD_NAME = "${env.REGISTRY_HOSTNAME}/${env.PROJECT}:${env.IMAGE_NAME}"
    }

    stages {
        stage('Clone repository') {
            steps {
                checkout scm
            }
        }

        stage('Clean .nvmrc files') {
            steps {
                script {
                    sh '''
                        echo "=== Removing ALL .nvmrc files ==="

                        # Удаляем ВСЕ .nvmrc файлы в workspace
                        find /home/abazunts/jenkins/workspace/prd-soc-net-main-pull-request \
                            -name ".nvmrc" \
                            -type f \
                            -delete 2>/dev/null || true

                        echo "✅ All .nvmrc files removed"
                    '''
                }
            }
        }

        stage('Clear NVM cache completely') {
            steps {
                script {
                    sh '''
                        echo "=== COMPLETE NVM CACHE CLEAR ==="

                        # 1. Kill any NVM processes
                        pkill -f "nvm" 2>/dev/null || true

                        # 2. Remove all NVM environment variables
                        for var in $(env | grep -i nvm | cut -d= -f1); do
                            unset "$var" 2>/dev/null || true
                        done

                        # 3. Clean PATH from NVM
                        CLEAN_PATH=""
                        IFS=':' read -ra PATHS <<< "$PATH"
                        for path in "${PATHS[@]}"; do
                            if [[ ! "$path" =~ /\.nvm/ ]]; then
                                CLEAN_PATH="${CLEAN_PATH}:${path}"
                            fi
                        done
                        export PATH="${CLEAN_PATH#:}"

                        # 4. Remove cache files
                        rm -rf "$HOME/.nvm/.cache" 2>/dev/null || true
                        rm -f "$HOME/.npm/_cacache/*" 2>/dev/null || true

                        # 5. Clear bash hash table
                        hash -r 2>/dev/null || true

                        # 6. Start fresh shell (optional)
                        exec bash --norc --noprofile -c "
                            echo 'Fresh shell started'
                            export PATH=\"/home/abazunts/.nvm/versions/node/v20.5.1/bin:$PATH\"
                            node --version
                        "

                        echo "✅ NVM cache cleared"
                    '''
                }
            }
        }

        stage('Install dependencies') {
            steps {
                script {
                     sh '''
                        export NVM_DIR="$HOME/.nvm"
                        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                        nvm use v20.5.1 --ignore-prev-failure
                        npm ci
                     '''
                }
            }
        }
//         stage('Unit tests') {
//             steps {
//                 script {
//                     sh '''
//                        export NVM_DIR="$HOME/.nvm"
//                        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
//                        nvm use --lts
//                        yarn install
//                        yarn test
//                     '''
//                 }
//             }
//         }
        stage('e2e tests') {
            steps {
                script {
                    sh '''
                       export NVM_DIR="$HOME/.nvm"
                       [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                       nvm use --lts
                       yarn test:e2e
                    '''
                }
            }
        }
        stage('Build docker image') {
            steps {
                echo "Build image started..."
                    script {
                       app = docker.build("${env.DOCKER_BUILD_NAME}", "--build-arg service=${env.SERVICE} --build-arg port=${env.PORT} -f ./apps/${env.SERVICE}/Dockerfile ./")
                    }
                echo "Build image finished..."
            }
        }
        stage('Push docker image') {
             steps {
                 echo "Push image started..."
                     script {
                        docker.withRegistry("https://${env.REGISTRY}", 'socialnetwork-ai-com') {
                            app.push("${env.IMAGE_NAME}")
                        }
                     }
                 echo "Push image finished..."
             }
       }
       stage('Delete image local') {
             steps {
                 script {
                    sh "docker rmi -f ${env.DOCKER_BUILD_NAME}"
                 }
             }
        }
        stage('Preparing deployment') {
             steps {
                 echo "Preparing started..."
                     sh 'ls -ltr'
                     sh 'pwd'
                     sh "chmod +x ./apps/${env.SERVICE}/preparingDeploy.sh"
                     sh "./apps/${env.SERVICE}/preparingDeploy.sh ${env.REGISTRY_HOSTNAME} ${env.PROJECT} ${env.IMAGE_NAME} ${env.DEPLOYMENT_NAME} ${env.PORT} ${env.NAMESPACE}"
                     sh "cat ./apps/${env.SERVICE}/deployment.yaml"
             }
        }
        stage('Deploy to Kubernetes') {
             steps {
                 withKubeConfig([credentialsId: 'prod-kubernetes']) {
                    sh "kubectl apply -f ./apps/${env.SERVICE}/deployment.yaml"
                    sh "kubectl rollout status deployment/${env.DEPLOYMENT_NAME} --namespace=${env.NAMESPACE}"
                    sh "kubectl get services -o wide"
                 }
             }
        }
    }
}
